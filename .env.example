# Backend manzili (https tavsiya etiladi production'da)
VITE_API_URL=https://crm-pro-backend.akaikumogo.uz

# Ko'rgazma sahifasidagi havola uchun (ixtiyoriy)
VITE_SHOWROOM_URL=http://localhost:5174

# Ko'rgazma sahifasida MQTT misol (haqiqiy topicni .env da saqlang)
VITE_MQTT_TOPIC_HINT=

# Blok sahifasida ko'rsatiladigan qo'llab-quvvatlash raqami
VITE_SUPPORT_PHONE=
